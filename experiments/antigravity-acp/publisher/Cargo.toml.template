[package]
name = "lens-antigravity-publisher-probe"
version = "0.0.0"
edition = "2021"
publish = false

[workspace]

[dependencies]
adapter-output-mcp = { path = @ADAPTER_OUTPUT_MCP_PATH@ }
agent-client-protocol-schema = "=1.7.0"
serde = { version = "=1.0.229", features = ["derive"] }
serde_json = "=1.0.151"
tokio = { version = "=1.53.1", features = ["rt", "macros", "io-util", "io-std"] }
uuid = { version = "=1.25.0", features = ["v4"] }
