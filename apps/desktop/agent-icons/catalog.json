{
  "version": 1,
  "assets": {
    "claude": "brands/claude.svg",
    "copilot": "brands/copilot.svg",
    "google": "brands/google.svg",
    "openai": "brands/openai.svg",
    "robot": "solid/robot.svg",
    "x-twitter": "brands/x-twitter.svg"
  },
  "rules": [
    {
      "containsAny": ["claude", "anthropic"],
      "icon": "claude"
    },
    {
      "containsAny": ["codex", "chatgpt", "openai"],
      "icon": "openai"
    },
    {
      "containsAny": ["copilot", "github"],
      "icon": "copilot"
    },
    {
      "containsAny": ["antigravity", "google"],
      "icon": "google"
    },
    {
      "containsAny": ["grok"],
      "icon": "x-twitter"
    }
  ],
  "fallback": "robot"
}
