{
  "name": "desktop",
  "version": "0.8.3",
  "private": true,
  "description": "Lens native integration, application composition and WebView delivery",
  "type": "module",
  "scripts": {
    "dev": "node tooling/prerender/dev.ts",
    "build": "pnpm run check:types && node tooling/prerender/build.ts",
    "build:assets": "node tooling/prerender/build.ts",
    "check:types": "tsc --build",
    "tauri": "node ../../scripts/macos-build-contract.ts && tauri",
    "test": "vitest run --config ../../vitest.config.ts --project desktop"
  },
  "dependencies": {
    "@lit-labs/ssr-client": "1.1.8",
    "@tauri-apps/api": "2.12.1",
    "@tauri-apps/plugin-dialog": "2.8.0",
    "@tauri-apps/plugin-opener": "2.7.0",
    "adapter-math-renderer": "workspace:*",
    "adapter-mcp-apps-host": "workspace:*",
    "adapter-mcp-apps-view": "workspace:*",
    "lit": "3.3.3",
    "ui": "workspace:*"
  },
  "devDependencies": {
    "@lit-labs/ssr": "4.1.0",
    "@tauri-apps/cli": "2.12.1",
    "@types/node": "24.19.0",
    "adapter-lit-prerenderer": "workspace:*",
    "jsdom": "30.1.1",
    "typescript": "7.0.2",
    "typescript-config": "workspace:*",
    "vite": "8.3.1",
    "vitest": "5.0.3"
  },
  "engines": {
    "node": "24.21.0",
    "pnpm": "12.8.1"
  }
}
