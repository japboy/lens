{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/v17.3.0/schemas/config.json",
  "release-type": "node",
  "always-update": true,
  "pull-request-footer": "Generated with [Release Please](https://github.com/googleapis/release-please). Review the proposed version and changelog before merging. Merging authorizes the annotated tag and verified DMG release pipeline.",
  "separate-pull-requests": false,
  "group-pull-request-title-pattern": "chore${scope}: release${component} ${version}",
  "include-component-in-tag": false,
  "include-v-in-tag": true,
  "bump-minor-pre-major": true,
  "bump-patch-for-minor-pre-major": false,
  "packages": {
    ".": {
      "package-name": "lens",
      "initial-version": "0.1.0",
      "extra-files": [
        {
          "type": "json",
          "path": "packages/typescript-config/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "apps/desktop/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "apps/desktop/src-tauri/tauri.conf.json",
          "jsonpath": "$.version"
        },
        {
          "type": "toml",
          "path": "Cargo.toml",
          "jsonpath": "$.workspace.package.version"
        }
      ]
    }
  }
}
