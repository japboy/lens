{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",

  extends: [
    "config:recommended",
    ":enableVulnerabilityAlerts",
    "helpers:pinGitHubActionDigests",
    "security:minimumReleaseAgeNpm",
  ],

  // The Renovate host must globally allow unsafe execution for "mise" so it
  // can refresh mise.lock; repository configuration cannot grant that authority.
  enabledManagers: ["npm", "cargo", "mise", "github-actions", "custom.regex"],
  timezone: "Asia/Tokyo",
  schedule: ["* 0-5 * * 1"],
  prCreation: "not-pending",
  minimumReleaseAge: "3 days",
  internalChecksFilter: "strict",
  platformAutomerge: true,
  automergeType: "pr",
  automergeStrategy: "squash",
  automerge: false,
  ignoreTests: false,
  separateMajorMinor: true,
  separateMinorPatch: false,
  labels: ["dependencies"],
  dependencyDashboard: true,
  osvVulnerabilityAlerts: true,

  lockFileMaintenance: {
    enabled: true,
    schedule: ["* 0-5 * * 1"],
  },

  customManagers: [
    {
      customType: "regex",
      description: "Release Please schema follows the pinned npm library.",
      managerFilePatterns: ["/^release-please-config\\.json$/"],
      matchStrings: [
        "https://raw\\.githubusercontent\\.com/googleapis/release-please/v(?<currentValue>\\d+\\.\\d+\\.\\d+)/schemas/config\\.json",
      ],
      depNameTemplate: "release-please",
      datasourceTemplate: "npm",
      versioningTemplate: "npm",
    },
    {
      customType: "regex",
      description: "hk Pkl package imports use the mise-managed hk release.",
      managerFilePatterns: ["/^hk\\.pkl$/"],
      matchStrings: [
        "download/v(?<currentValue>\\d+\\.\\d+\\.\\d+)/hk@",
        "hk@(?<currentValue>\\d+\\.\\d+\\.\\d+)#/",
      ],
      depNameTemplate: "jdx/hk",
      datasourceTemplate: "github-releases",
      extractVersionTemplate: "^v(?<version>.*)$",
      versioningTemplate: "semver",
    },
  ],

  packageRules: [
    {
      description: "npm and Cargo manifest versions are pinned.",
      matchManagers: ["npm", "cargo"],
      rangeStrategy: "pin",
    },
    {
      description: "Application library updates share a group across languages.",
      matchManagers: ["npm", "cargo"],
      groupName: "Application dependencies",
    },
    {
      description: "npm development dependencies share a tooling group.",
      matchManagers: ["npm"],
      matchDepTypes: ["devDependencies"],
      groupName: "Development tooling",
    },
    {
      description: "Build/test-only Cargo libraries share the tooling group; crates also used at runtime stay in the application group.",
      matchManagers: ["cargo"],
      matchPackageNames: ["cc", "toml", "pretty_assertions"],
      groupName: "Development tooling",
    },
    {
      description: "mise-managed development tools share the tooling group.",
      matchManagers: ["mise"],
      groupName: "Development tooling",
    },
    {
      description: "GitHub Actions updates share a CI group.",
      matchManagers: ["github-actions"],
      groupName: "GitHub Actions",
    },
    // Coupled families take precedence over the broad groups above. Their branch
    // names do not split by SemVer level, including across package managers.
    {
      description: "Tauri JavaScript bindings, Rust crates, and CLI update together.",
      matchPackageNames: ["@tauri-apps/**", "tauri", "tauri-build", "tauri-plugin-**"],
      groupName: "Tauri dependencies",
      separateMajorMinor: false,
    },
    {
      description: "ACP protocol, schema, and adapters update together across languages.",
      matchPackageNames: [
        "@agentclientprotocol/**",
        "agent-client-protocol",
        "agent-client-protocol-schema",
      ],
      groupName: "ACP dependencies",
      separateMajorMinor: false,
    },
    {
      description: "Lit rendering and server-side rendering packages update together.",
      matchPackageNames: ["lit", "lit-html", "lit-element", "@lit/**", "@lit-labs/**"],
      groupName: "Lit dependencies",
      separateMajorMinor: false,
    },
    {
      description: "Generative DOM core and rendering plugins update together.",
      matchPackageNames: ["@generative-dom/**"],
      groupName: "Generative DOM dependencies",
      separateMajorMinor: false,
    },
    {
      description: "Development and managed Agent Node versions update together.",
      matchPackageNames: ["node"],
      groupName: "Node.js runtime",
      separateMajorMinor: false,
    },
    {
      description: "Development and managed Agent pnpm share the mise version and native artifact lock.",
      matchManagers: ["npm", "mise"],
      matchPackageNames: ["pnpm"],
      groupName: "pnpm",
      separateMajorMinor: false,
    },
    {
      description: "hk runtime and Pkl package imports update together.",
      matchPackageNames: ["hk", "jdx/hk"],
      groupName: "hk",
      separateMajorMinor: false,
      minimumGroupSize: 5,
    },
    {
      description: "Release Please library and schema update together.",
      matchManagers: ["npm", "custom.regex"],
      matchPackageNames: ["release-please"],
      groupName: "release-please",
      separateMajorMinor: false,
      minimumGroupSize: 2,
    },
    {
      description: "Patch updates are automatically merged after required checks pass.",
      matchUpdateTypes: ["patch"],
      automerge: true,
    },
    {
      description: "npm and Cargo pin updates are automatically merged after required checks pass.",
      matchManagers: ["npm", "cargo"],
      matchUpdateTypes: ["pin", "pinDigest"],
      automerge: true,
    },
    {
      description: "npm development dependency minor updates are automatically merged.",
      matchManagers: ["npm"],
      matchDepTypes: ["devDependencies"],
      matchUpdateTypes: ["minor"],
      automerge: true,
    },
    {
      description: "Cargo build and test dependency minor updates are automatically merged.",
      matchManagers: ["cargo"],
      matchDepTypes: ["build-dependencies", "dev-dependencies"],
      matchUpdateTypes: ["minor"],
      automerge: true,
    },
    {
      description: "Development tool and CI minor updates are automatically merged.",
      matchManagers: ["mise", "github-actions"],
      matchUpdateTypes: ["minor"],
      automerge: true,
    },
    {
      description: "Mirrored development tool minor updates share the same merge policy.",
      matchManagers: ["npm", "mise", "custom.regex"],
      matchPackageNames: ["release-please", "hk", "jdx/hk"],
      matchUpdateTypes: ["minor"],
      automerge: true,
    },
    {
      description: "Node minor updates require review because Node also executes managed Agents.",
      matchPackageNames: ["node"],
      matchUpdateTypes: ["minor"],
      automerge: false,
    },
    {
      description: "GitHub Action digest updates are automatically merged after required checks pass.",
      matchManagers: ["github-actions"],
      matchUpdateTypes: ["digest", "pinDigest"],
      automerge: true,
    },
    {
      description: "npm lock-file maintenance is automatically merged after required checks pass.",
      matchManagers: ["npm"],
      matchUpdateTypes: ["lockFileMaintenance"],
      automerge: true,
    },
    {
      description: "pnpm minor updates require review because the same version installs managed Agents.",
      matchPackageNames: ["pnpm"],
      matchUpdateTypes: ["minor"],
      automerge: false,
    },
    // Renovate enables branch automerge only when every grouped update permits it.
    // A runtime minor or any major therefore keeps the entire group under review.
    {
      description: "Major updates require manual approval and are never automatically merged.",
      matchUpdateTypes: ["major"],
      dependencyDashboardApproval: true,
      automerge: false,
    },
    {
      description: "Cargo-only lock maintenance is disabled without release-age validation.",
      matchManagers: ["cargo"],
      matchUpdateTypes: ["lockFileMaintenance"],
      enabled: false,
    },
    {
      description: "Standalone mise.lock maintenance is disabled; lock changes accompany explicit tool updates.",
      matchManagers: ["mise"],
      matchUpdateTypes: ["lockFileMaintenance"],
      enabled: false,
    },
  ],
}
