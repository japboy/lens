{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",

  extends: [
    "config:recommended",
    ":enableVulnerabilityAlerts",
    "helpers:pinGitHubActionDigests",
    "security:minimumReleaseAgeNpm",
  ],

  // The Renovate host must globally allow unsafe execution for "mise" so it
  // can refresh mise.lock; repository configuration cannot grant that authority.
  enabledManagers: ["npm", "cargo", "mise", "github-actions", "custom.regex"],
  timezone: "Asia/Tokyo",
  schedule: ["* 0-5 * * 1"],
  prCreation: "not-pending",
  minimumReleaseAge: "3 days",
  internalChecksFilter: "strict",
  platformAutomerge: true,
  automergeType: "pr",
  automergeStrategy: "squash",
  automerge: false,
  ignoreTests: false,
  separateMinorPatch: true,
  labels: ["dependencies"],
  dependencyDashboard: true,
  osvVulnerabilityAlerts: true,

  lockFileMaintenance: {
    enabled: true,
    schedule: ["* 0-5 * * 1"],
  },

  customManagers: [
    {
      customType: "regex",
      description: "hk Pkl package imports use the mise-managed hk release.",
      managerFilePatterns: ["/^hk\\.pkl$/"],
      matchStrings: [
        "download/v(?<currentValue>\\d+\\.\\d+\\.\\d+)/hk@",
        "hk@(?<currentValue>\\d+\\.\\d+\\.\\d+)#/",
      ],
      depNameTemplate: "jdx/hk",
      datasourceTemplate: "github-releases",
      extractVersionTemplate: "^v(?<version>.*)$",
      versioningTemplate: "semver",
    },
  ],

  packageRules: [
    {
      description: "npm manifest versions are pinned.",
      matchManagers: ["npm"],
      rangeStrategy: "pin",
    },
    {
      description: "Tauri framework updates are grouped.",
      matchPackageNames: ["@tauri-apps/**", "tauri", "tauri-build", "tauri-plugin-**"],
      groupName: "Tauri dependencies",
    },
    {
      description: "ACP protocol and adapter updates are grouped.",
      matchPackageNames: ["@agentclientprotocol/**", "agent-client-protocol"],
      groupName: "ACP dependencies",
    },
    {
      description: "JavaScript and TypeScript build, test, lint, format, and type updates are grouped.",
      matchPackageNames: [
        "@types/node",
        "typescript",
        "vite",
        "vitest",
        "jsdom",
        "oxfmt",
        "oxlint",
      ],
      groupName: "JavaScript and TypeScript tooling",
    },
    {
      description: "hk runtime and configuration updates are grouped.",
      matchPackageNames: ["hk", "jdx/hk"],
      groupName: "hk",
      automerge: false,
    },
    {
      description: "npm and Cargo patch or pin updates are automatically merged after required checks pass.",
      matchManagers: ["npm", "cargo"],
      matchUpdateTypes: ["patch", "pin", "pinDigest"],
      automerge: true,
    },
    {
      description: "GitHub Action digest updates are automatically merged after required checks pass.",
      matchManagers: ["github-actions"],
      matchUpdateTypes: ["digest", "pinDigest"],
      automerge: true,
    },
    {
      description: "npm lock-file maintenance is automatically merged after required checks pass.",
      matchManagers: ["npm"],
      matchUpdateTypes: ["lockFileMaintenance"],
      automerge: true,
    },
    {
      description: "Minor updates require manual review.",
      matchUpdateTypes: ["minor"],
      automerge: false,
    },
    {
      description: "Major updates require manual approval.",
      matchUpdateTypes: ["major"],
      dependencyDashboardApproval: true,
      automerge: false,
    },
    {
      description: "ACP protocol and managed runtime updates require manual review.",
      matchPackageNames: ["@agentclientprotocol/**", "agent-client-protocol"],
      automerge: false,
    },
    {
      description: "Development and managed Agent Node versions share the mise lock and update together.",
      matchPackageNames: ["node"],
      groupName: "Node.js runtime",
      automerge: false,
    },
    {
      description: "mise-managed tool updates require manual review.",
      matchManagers: ["mise"],
      automerge: false,
    },
    {
      description: "Cargo-only lock maintenance is disabled without release-age validation.",
      matchManagers: ["cargo"],
      matchUpdateTypes: ["lockFileMaintenance"],
      enabled: false,
    },
    {
      description: "Standalone mise.lock maintenance is disabled; lock changes accompany explicit tool updates.",
      matchManagers: ["mise"],
      matchUpdateTypes: ["lockFileMaintenance"],
      enabled: false,
    },
  ],
}
