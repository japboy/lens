{
  "name": "personal-lens",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "check:language": "node scripts/check-repository-language.mjs",
    "check:publication": "node scripts/check-publication-boundary.mjs",
    "sidecars:build": "src-tauri/sidecars/build-sidecars.sh",
    "check": "npm run build && npm run sidecars:build && cargo check --manifest-path src-tauri/Cargo.toml",
    "verify": "npm run check:publication && npm run check:language && npm run check && npm test && cargo fmt --manifest-path src-tauri/Cargo.toml -- --check && cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings && cargo test --manifest-path src-tauri/Cargo.toml",
    "tauri": "tauri",
    "test": "vitest run"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "7.3.1",
    "@generative-dom/core": "0.4.0",
    "@generative-dom/plugin-cursor": "0.4.0",
    "@generative-dom/plugin-markdown-base": "0.4.0",
    "@generative-dom/plugin-markdown-code": "0.4.0",
    "@generative-dom/plugin-markdown-heading": "0.4.0",
    "@generative-dom/plugin-markdown-inline": "0.4.0",
    "@generative-dom/plugin-markdown-link": "0.4.0",
    "@generative-dom/plugin-markdown-list": "0.4.0",
    "@generative-dom/plugin-markdown-quote": "0.4.0",
    "@generative-dom/plugin-markdown-table": "0.4.0",
    "@tauri-apps/api": "2.11.1",
    "@tauri-apps/plugin-dialog": "2.7.2",
    "@tauri-apps/plugin-opener": "2.5.4",
    "dompurify": "3.4.14",
    "lit": "3.3.3",
    "marked": "18.0.10"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.11.4",
    "jsdom": "30.0.1",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  }
}
