{
  "name": "lens",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "pnpm run check:types && vite build",
    "check:identity": "node scripts/check-product-identity.ts",
    "check:terminology": "node scripts/check-product-terminology.ts",
    "check:language": "node scripts/check-repository-language.ts",
    "check:publication": "node scripts/check-publication-boundary.ts",
    "check:quality": "mise exec -- hk check --all",
    "check:rust": "mise exec -- cargo check --manifest-path src-tauri/Cargo.toml --locked",
    "check:types": "tsc --build",
    "check:dependencies": "mise exec -- cargo deny --manifest-path src-tauri/Cargo.toml check",
    "check": "pnpm run build && pnpm run check:rust",
    "fix": "mise exec -- hk fix --all",
    "verify": "pnpm run verify:portable && pnpm run verify:native",
    "verify:native": "pnpm run check:rust && mise exec -- cargo clippy --manifest-path src-tauri/Cargo.toml --locked --all-targets -- -D warnings && mise exec -- cargo test --manifest-path src-tauri/Cargo.toml --locked && pnpm run check:dependencies",
    "verify:portable": "pnpm run check:identity && pnpm run check:terminology && pnpm run check:publication && pnpm run check:language && pnpm run check:quality && pnpm run build && pnpm test",
    "tauri": "tauri",
    "test": "vitest run",
    "validate:live-sync-native": "node scripts/validate-live-sync-native.ts"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "7.3.1",
    "@generative-dom/core": "0.4.0",
    "@generative-dom/plugin-cursor": "0.4.0",
    "@generative-dom/plugin-markdown-base": "0.4.0",
    "@generative-dom/plugin-markdown-code": "0.4.0",
    "@generative-dom/plugin-markdown-heading": "0.4.0",
    "@generative-dom/plugin-markdown-inline": "0.4.0",
    "@generative-dom/plugin-markdown-link": "0.4.0",
    "@generative-dom/plugin-markdown-list": "0.4.0",
    "@generative-dom/plugin-markdown-quote": "0.4.0",
    "@generative-dom/plugin-markdown-table": "0.4.0",
    "@tauri-apps/api": "2.11.1",
    "@tauri-apps/plugin-dialog": "2.7.2",
    "@tauri-apps/plugin-opener": "2.5.4",
    "dompurify": "3.4.14",
    "lit": "3.3.3",
    "marked": "18.0.10",
    "mermaid": "11.17.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.11.4",
    "@types/node": "24.13.3",
    "jsdom": "30.0.1",
    "oxfmt": "0.64.0",
    "oxlint": "1.79.0",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": "24.19.0",
    "pnpm": "11.22.0"
  },
  "packageManager": "pnpm@11.22.0"
}
