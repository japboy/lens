{
  "name": "adapter-math-renderer",
  "version": "0.11.0",
  "private": true,
  "description": "Shared TeX rendering for Markdown and HTML, with pinned CSS/font resources",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./node": "./src/node/index.ts",
    "./html-math-manifest": "./src/node/html-math-manifest.ts"
  },
  "scripts": {
    "check:types": "tsc --build",
    "test": "vitest run --config ../../vitest.config.ts --project math-renderer"
  },
  "dependencies": {
    "katex": "0.19.0",
    "marked": "18.1.1",
    "parse5": "8.0.1",
    "vite": "8.3.4"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "jsdom": "30.1.3",
    "typescript": "7.0.2",
    "typescript-config": "workspace:*",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": "24.21.0",
    "pnpm": "12.8.1"
  }
}
