{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Minimal permissions for the on-demand Settings and Lens windows.",
  "windows": ["settings"],
  "permissions": [
    "core:default",
    "core:event:default",
    "core:window:allow-close",
    "core:window:allow-hide",
    "dialog:allow-open"
  ]
}
